        "PRODUCT_BUNDLE_IDENTIFIER": "de.gerasymenko.ExampleProjectInGroup",
        "PRODUCT_NAME": "$(TARGET_NAME:c99extidentifier)",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
