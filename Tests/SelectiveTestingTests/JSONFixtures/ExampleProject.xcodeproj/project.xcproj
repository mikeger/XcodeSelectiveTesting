{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "ExamplePackage" },
    {
      "kind": "group",
      "path": "ExampleProject",
      "children": [
        { "path": "ExampleProjectApp.swift", "target-membership": [ "ExampleProject/compile-sources" ] },
        {
          "kind": "folder",
          "path": "DeepFolder",
          "opaque-folders": [
            "Path/ExcludedFolder",
          ],
          "target-membership": [
            "ExampleProject",
          ],
          "membership-exceptions": [
            {
              "target": "ExampleProject",
              "exclusions": [
                "Path/ExceptionView.swift",
                "Path/ExcludedFolder",
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "DeepGroup",
          "children": [
            {
              "kind": "group",
              "path": "Path",
              "children": [
                { "path": "GroupContentView.swift", "target-membership": [ "ExampleProject/compile-sources" ] },
              ],
            },
          ],
        },
        { "path": "Assets.xcassets", "target-membership": [ "ExampleProject/resources" ] },
        {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            { "path": "Preview Assets.xcassets", "target-membership": [ "ExampleProject/resources" ] },
          ],
        }, {
          "kind": "variant-group",
          "name": "Example.xib",
          "target-membership": [
            "ExampleProject/resources",
          ],
          "children": [
            {
              "path": "Base.lproj/Example.xib",
            }, {
              "path": "en.lproj/Example.strings",
            },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "ExampleProjectTests",
      "children": [
        { "path": "ExampleProjectTests.swift", "target-membership": [ "ExampleProjectTests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "path": "ExampleProjectUITests",
      "children": [
        { "path": "ExampleProjectUITests.swift", "target-membership": [ "ExampleProjectUITests/compile-sources" ] },
        { "path": "ExampleProjectUITestsLaunchTests.swift", "target-membership": [ "ExampleProjectUITests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "path": "ExmapleTargetLibrary",
      "children": [
        { "path": "ExmapleTargetLibrary.h", "target-membership": [ { "build-phase": "ExmapleTargetLibrary/headers", "header-role": "public" } ] },
        { "path": "ExmapleTargetLibrary.docc", "target-membership": [ "ExmapleTargetLibrary/compile-sources" ] },
        { "path": "ExampleTargetLibrary.swift", "target-membership": [ "ExmapleTargetLibrary/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "path": "ExmapleTargetLibraryTests",
      "children": [
        { "path": "ExmapleTargetLibraryTests.swift", "target-membership": [ "ExmapleTargetLibraryTests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/ExampleProject.app", "id": "276DB5BB29B144C900E5C615", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ExampleProjectTests.xctest", "id": "276DB5CB29B144CA00E5C615", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/ExampleProjectUITests.xctest", "id": "276DB5D529B144CA00E5C615", "type": "wrapper.cfbundle", "index": false },
        {
          "path": "<PRODUCTS>/ExmapleTargetLibrary.framework",
          "id": "27F467E529B1457600A93E94",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            "ExampleProject/frameworks",
            { "build-phase": "ExampleProject/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "ExmapleTargetLibraryTests/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/ExmapleTargetLibraryTests.xctest", "id": "27F467EE29B1457600A93E94", "type": "wrapper.cfbundle", "index": false },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<PRODUCTS>/ExampleLibrary.framework", "type": "wrapper.framework", "target-membership": [ "ExampleProject/frameworks" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "ExampleProject",
      "id": "276DB5BA29B144C900E5C615",
      "product": "Products/ExampleProject.app",
      "product-type": "application",
      "dependencies": [
        "ExmapleTargetLibrary",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "ExamplePackage",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_ASSET_PATHS": "\"ExampleProject/Preview Content\"",
        "DEVELOPMENT_TEAM": "4ZT53YQ627",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "de.gerasymenko.ExampleProject",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "ExampleProjectTests",
      "id": "276DB5CA29B144CA00E5C615",
      "product": "Products/ExampleProjectTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "ExampleProject",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES",
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "4ZT53YQ627",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "16.2",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "de.gerasymenko.ExampleProjectTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/ExampleProject.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/ExampleProject",
      },
    }, {
      "name": "ExampleProjectUITests",
      "id": "276DB5D429B144CA00E5C615",
      "product": "Products/ExampleProjectUITests.xctest",
      "product-type": "bundle.ui-testing",
      "dependencies": [
        "ExampleProject",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
